<?xml version="1.0" encoding="utf-8"?>
<!-- Burraco la Sfida: Eventi del Circolo (widget e avvisi): activity principale, configurazione widget, provider widget, ricevitori allarmi e sistema. INTERNET solo per orari aggiornati e controllo nuova versione (GitHub). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sveglie esatte per aggiornare i widget all'istante del cambio e per gli avvisi: app promemoria/calendario fuori dal Play Store. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <queries>
        <package android:name="com.WhatWapp.BurracoOnline" />
    </queries>

    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:allowBackup="true" android:supportsRtl="true" android:theme="@style/AppTheme">

        <activity android:name=".ui.MainActivity" android:exported="true" android:label="@string/launcher_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".widget.WidgetConfigActivity" android:exported="true"
            android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.BurracoWidget" android:exported="true" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>

        <receiver android:name=".notify.NotifyReceiver" android:exported="false" />
        <receiver android:name=".widget.PinReceiver" android:exported="false" />

        <receiver android:name=".SystemEvents" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
