<?xml version="1.0" encoding="utf-8"?>
<!-- Striscia larga e bassa (4×1) per un evento: barra colore | icona | nome e stato | countdown a destra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="12dp" android:paddingEnd="14dp" android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <ImageView android:id="@+id/accent" android:layout_width="3dp" android:layout_height="30dp"
        android:layout_marginEnd="10dp" android:src="@drawable/accent_bar" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="10dp" android:textSize="20sp" />
    <ImageView android:id="@+id/icon_img" android:layout_width="@dimen/icon_img_l" android:layout_height="@dimen/icon_img_l" android:layout_marginEnd="10dp"
        android:importantForAccessibility="no" android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3"
        android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1"
            android:textColor="@color/text" android:textSize="14sp" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:drawablePadding="4dp" android:maxLines="1"
            android:textColor="@color/text_dim" android:textSize="11sp" />
    </LinearLayout>
    <Chronometer android:id="@+id/chrono" style="@style/AutoCountdown" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"
        android:gravity="end|center_vertical" android:autoSizeMaxTextSize="26sp" />
    <TextView android:id="@+id/when" style="@style/AutoCountdown" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"
        android:gravity="end|center_vertical" android:autoSizeMaxTextSize="18sp"
        android:visibility="gone" />
</LinearLayout>
