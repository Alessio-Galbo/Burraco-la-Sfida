<?xml version="1.0" encoding="utf-8"?>
<!-- Cella della striscia "tutti" (3 colonne uguali): icona, nome breve e punto di stato, countdown autoadattato. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:layout_marginEnd="4dp" android:background="@drawable/card_bg" android:orientation="vertical"
    android:paddingStart="8dp" android:paddingEnd="6dp" android:paddingTop="5dp" android:paddingBottom="5dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="4dp" android:textSize="@dimen/icon_s" />
        <ImageView android:id="@+id/icon_img" android:layout_width="@dimen/icon_img_s" android:layout_height="@dimen/icon_img_s" android:layout_marginEnd="4dp"
            android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/short_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:textColor="@color/text" android:textSize="12sp" />
        <ImageView android:id="@+id/dot" android:layout_width="6dp" android:layout_height="6dp"
            android:layout_marginStart="3dp" android:src="@drawable/dot_live" android:importantForAccessibility="no" />
    </LinearLayout>
    <Chronometer android:id="@+id/chrono" style="@style/AutoCountdown" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:autoSizeMaxTextSize="22sp" />
    <TextView android:id="@+id/when" style="@style/AutoCountdown" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:autoSizeMaxTextSize="15sp"
        android:visibility="gone" />
</LinearLayout>
