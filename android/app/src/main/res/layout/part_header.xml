<?xml version="1.0" encoding="utf-8"?>
<!-- Intestazione evento nei widget medio/grande: barra colore, icona e nome (testo autoadattato). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/accent" android:layout_width="3dp" android:layout_height="18dp"
        android:layout_marginEnd="6dp" android:src="@drawable/accent_bar" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="6dp" android:textSize="@dimen/icon_s" />
    <ImageView android:id="@+id/icon_img" android:layout_width="@dimen/icon_img_s" android:layout_height="@dimen/icon_img_s" android:layout_marginEnd="6dp"
        android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="22dp"
        android:layout_weight="1" android:autoSizeMaxTextSize="16sp" android:autoSizeMinTextSize="12sp"
        android:autoSizeTextType="uniform" android:fontFamily="sans-serif-medium" android:gravity="center_vertical"
        android:ellipsize="end" android:maxLines="1" android:text="@string/widget_label" android:textColor="@color/text" />
</LinearLayout>
