<?xml version="1.0" encoding="utf-8"?>
<!-- Widget piccolo (1×1 alto, colonne strette): icona, countdown ed etichetta distribuiti su tutta l'altezza. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center_horizontal" android:orientation="vertical"
    android:padding="8dp">
    <FrameLayout android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:textSize="22sp" />
        <ImageView android:id="@+id/icon_img" android:layout_width="@dimen/icon_img_xl"
            android:layout_height="@dimen/icon_img_xl" android:layout_gravity="center"
            android:importantForAccessibility="no" android:visibility="gone" />
    </FrameLayout>
    <Chronometer android:id="@+id/chrono" style="@style/AutoCountdown" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1.2" android:minHeight="28dp" android:gravity="center"
        android:autoSizeMaxTextSize="26sp" />
    <TextView android:id="@+id/when" style="@style/AutoCountdown" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1.2" android:minHeight="28dp" android:gravity="center"
        android:autoSizeMaxTextSize="18sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_horizontal|top" android:orientation="vertical">
        <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:drawablePadding="3dp" android:maxLines="1" android:textColor="@color/text_dim"
            android:textSize="10sp" />
        <include layout="@layout/part_segments" />
        <ProgressBar android:id="@+id/prog" style="@style/Bar" android:layout_width="match_parent"
            android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:layout_marginTop="5dp" />
    </LinearLayout>
</LinearLayout>
