<?xml version="1.0" encoding="utf-8"?>
<!-- Widget grande e alto (da 2×3 in su, anche largo): countdown che cresce al centro; nome, stato, countdown grande, fase Torte con barra a 5 segmenti, inizio e fine. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <include layout="@layout/part_header" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:drawablePadding="4dp" android:ellipsize="end" android:maxLines="1"
        android:textColor="@color/text_dim" android:textSize="12sp" />
    <Chronometer android:id="@+id/chrono" style="@style/AutoCountdown" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:autoSizeMaxTextSize="64sp" />
    <TextView android:id="@+id/when" style="@style/AutoCountdown" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:autoSizeMaxTextSize="45sp"
        android:visibility="gone" />
    <TextView android:id="@+id/line" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="2" android:textColor="@color/text_dim" android:textSize="13sp" />
    <include layout="@layout/part_segments" />
    <TextView android:id="@+id/span" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1"
        android:textColor="@color/text_dim" android:textSize="@dimen/text_s" />
    <ProgressBar android:id="@+id/prog" style="@style/Bar" android:layout_width="match_parent"
        android:layout_marginTop="6dp" />
</LinearLayout>
