<?xml version="1.0" encoding="utf-8"?>
<!-- Temi (Gioco, Chiaro, Sistema) e stili compatti (docs/design.md: testi 11-17sp, raggi 8dp). -->
<resources>
    <style name="SystemBase" parent="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- Temi dell'app (stile predefinito scelto nella schermata principale, docs/design.md "Temi e icone"). -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="appBg">@color/bg</item>
        <item name="appSurface">@color/surface</item>
        <item name="appSurface2">@color/surface_2</item>
        <item name="appLine">@color/line</item>
        <item name="appText">@color/text</item>
        <item name="appTextDim">@color/text_dim</item>
        <item name="appAccent">@color/gold</item>
        <item name="appOnAccent">@color/bg</item>
        <item name="appLink">@color/blue</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="AppTheme.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="appBg">@color/l_bg</item>
        <item name="appSurface">@color/l_surface</item>
        <item name="appSurface2">@color/l_surface_2</item>
        <item name="appLine">@color/l_line</item>
        <item name="appText">@color/l_text</item>
        <item name="appTextDim">@color/l_text_dim</item>
        <item name="appAccent">@color/l_accent</item>
        <item name="appOnAccent">@color/l_on_accent</item>
        <item name="appLink">@color/l_link</item>
        <item name="android:colorPrimary">@color/l_bg</item>
        <item name="android:colorPrimaryDark">@color/l_bg</item>
        <item name="android:colorAccent">@color/l_accent</item>
        <item name="android:windowBackground">@color/l_bg</item>
        <item name="android:textColorPrimary">@color/l_text</item>
        <item name="android:textColorSecondary">@color/l_text_dim</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Sistema: base chiara qui, scura in values-night (SystemBase). -->
    <style name="AppTheme.System" parent="@style/SystemBase">
        <item name="appBg">@color/s_bg</item>
        <item name="appSurface">@color/s_surface</item>
        <item name="appSurface2">@color/s_surface_2</item>
        <item name="appLine">@color/s_line</item>
        <item name="appText">@color/s_text</item>
        <item name="appTextDim">@color/s_text_dim</item>
        <item name="appAccent">@color/s_accent</item>
        <item name="appOnAccent">@color/s_on_accent</item>
        <item name="appLink">@color/s_link</item>
        <item name="android:colorPrimary">@color/s_bg</item>
        <item name="android:colorPrimaryDark">@color/s_bg</item>
        <item name="android:colorAccent">@color/s_accent</item>
        <item name="android:windowBackground">@color/s_bg</item>
        <item name="android:textColorPrimary">@color/s_text</item>
        <item name="android:textColorSecondary">@color/s_text_dim</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appAccent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
    <style name="GoldButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/button_gold</item>
        <item name="android:textColor">?attr/appOnAccent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="OutlineButton" parent="GoldButton">
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:textColor">?attr/appText</item>
    </style>
    <style name="SettingSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">?attr/appText</item>
        <item name="android:textSize">@dimen/text_m</item>
    </style>
    <!-- Link a tutta larghezza come sul sito (.links): bordo, raggio 8dp, icona 18dp + testo del tema. -->
    <style name="LinkButton" parent="OutlineButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">10dp</item>
    </style>
    <style name="LinkText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appLink</item>
        <item name="android:textSize">@dimen/text_m</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <!-- Countdown che si adatta allo spazio (autoSize, API 26+, valido nelle RemoteViews). -->
    <style name="AutoCountdown">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Bar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_height">3dp</item>
        <item name="android:max">1000</item>
        <item name="android:progressDrawable">@drawable/bar_progress</item>
        <item name="android:minHeight">3dp</item>
        <item name="android:maxHeight">3dp</item>
    </style>
</resources>
