<?xml version="1.0" encoding="utf-8"?>
<!-- Pulsante Ko-fi: rosso corallo #ff5e5b, più scuro se premuto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#E04E4B" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FF5E5B" /><corners android:radius="18dp" /></shape>
    </item>
</selector>
