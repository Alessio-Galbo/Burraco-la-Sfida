<?xml version="1.0" encoding="utf-8"?>
<!-- Sfondo dei pulsanti di scelta: superficie del tema, bordo d'accento se selezionato, più marcato se premuto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="?attr/appSurface2" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/appSurface" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appSurface" />
            <stroke android:width="1dp" android:color="?attr/appLine" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
